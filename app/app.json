{
  "expo": {
    "name": "Social Collection",
    "slug": "social-collection",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "socialcollection",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.socialcollection.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#6C63FF"
      },
      "package": "com.socialcollection.app"
    },
    "plugins": ["expo-router", "expo-image-picker"]
  }
}
